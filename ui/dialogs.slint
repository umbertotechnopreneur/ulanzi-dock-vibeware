import { AboutSlint, CheckBox, ComboBox, ScrollView, SpinBox } from "std-widgets.slint";
import { Palette as WidgetPalette } from "std-widgets.slint";

global Palette {
    out property <color> paper: #fff4dc;
    out property <color> ink: #232a2f;
    out property <color> blue: #3a6a96;
    out property <color> muted: #526573;
}

component PixelButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked();
    min-width: 90px;
    height: 36px;
    border-width: focus.has-focus ? 3px : 2px;
    border-color: Palette.ink;
    background: !root.enabled ? #dfddcf : touch.pressed ? Palette.ink : root.primary ? Palette.blue : Palette.paper;
    accessible-role: button;
    accessible-label: root.text;
    forward-focus: focus;
    Text {
        text: root.text;
        font-weight: 600;
        color: !root.enabled ? Palette.muted : root.primary || touch.pressed ? Palette.paper : Palette.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        enabled: root.enabled;
        touch := TouchArea {
            enabled: root.enabled;
            clicked => { focus.focus(); root.clicked(); }
        }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component VibeWareLink inherits Rectangle {
    callback clicked();
    width: 64px;
    height: 64px;
    clip: true;
    background: transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Palette.blue;
    accessible-role: button;
    accessible-label: "Participates in VibeWare. Read the manifesto";
    forward-focus: focus;
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/brand/vibeware-logo.png");
        image-fit: contain;
    }
    focus := FocusScope {
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { focus.focus(); root.clicked(); }
        }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// Bound the image to its allocated box instead of exposing its native pixel
// dimensions as layout constraints inside the scrollable dialogs.
component ProductWordmark inherits Rectangle {
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    min-height: 88px;
    max-height: 88px;
    clip: true;
    background: transparent;
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/brand/ulanzi-dock-logo.png");
        image-fit: contain;
    }
}

component VibeWareFooter inherits Rectangle {
    callback learn();
    in property <string> disclosure: "I created this software with AI assistance.";
    background: #e2e5dc;
    border-width: 2px;
    border-color: Palette.ink;
    HorizontalLayout {
        padding: 12px;
        spacing: 8px;
        VerticalLayout {
            spacing: 6px;
            Text { text: "This is VibeWare"; color: Palette.blue; font-weight: 700; }
            Text { text: root.disclosure; color: Palette.ink; font-size: 12px; wrap: word-wrap; }
            PixelButton { text: "What is VibeWare?"; clicked => { root.learn(); } }
        }
        VibeWareLink { clicked => { root.learn(); } }
    }
}

export component AboutDialog inherits Window {
    init => { WidgetPalette.color-scheme = ColorScheme.light; }
    title: "About UlanziDock VibeWare";
    preferred-width: 560px;
    preferred-height: 660px;
    min-width: 420px;
    min-height: 360px;
    background: Palette.paper;
    default-font-family: "Consolas";
    default-font-size: 14px;
    in property <string> version;
    icon: @image-url("../assets/brand/ulanzi-dock-icon.png");
    in-out property <string> message;
    callback open-link(string);
    callback configure();
    callback dismiss();
    VerticalLayout {
     spacing: 0px;
     ScrollView {
      horizontal-scrollbar-policy: always-off;
      viewport-width: self.visible-width;
      VerticalLayout {
        padding: 22px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            ProductWordmark { }
            VibeWareLink { clicked => { root.open-link("manifesto"); } }
        }
        Text { text: "Open dock driver · v" + root.version; color: Palette.muted; horizontal-alignment: center; }
        Text { text: "Lightweight. Free. An alternative to the official Ulanzi app."; color: Palette.ink; horizontal-alignment: center; wrap: word-wrap; }
        Text {
            text: "I provide this software independently and as-is, without warranty. Use it at your own risk.";
            color: Palette.muted;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text { text: "I'm Umberto Giacobbi · MIT"; color: Palette.ink; horizontal-alignment: center; }
        HorizontalLayout {
            spacing: 8px;
            PixelButton { text: "UlanziDock"; clicked => { root.open-link("project"); } }
            PixelButton { text: "VibeWare"; clicked => { root.open-link("vibeware"); } }
            PixelButton { text: "My website"; clicked => { root.open-link("website"); } }
        }
        Rectangle {
            min-height: 130px;
            max-height: 130px;
            background: Palette.paper;
            clip: true;
            AboutSlint { width: parent.width; height: parent.height; }
        }
        Text { text: root.message; color: Palette.muted; wrap: word-wrap; visible: root.message != ""; }
        VibeWareFooter {
            disclosure: "I created this software with AI assistance. I define its purpose, guide the implementation, and take responsibility for checking functionality, performance and security. I share this weekend project as a participant in my VibeWare initiative.";
            learn => { root.open-link("manifesto"); }
        }
        HorizontalLayout {
            spacing: 8px;
            PixelButton { text: "Terms"; clicked => { root.open-link("terms"); } }
            PixelButton { text: "Privacy"; clicked => { root.open-link("privacy"); } }
        }
      }
     }
     VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 12px;
        padding-bottom: 22px;
        HorizontalLayout {
            spacing: 8px;
            PixelButton { text: "Configure"; primary: true; clicked => { root.configure(); } }
            PixelButton { text: "Close"; clicked => { root.dismiss(); } }
        }
     }
    }
}

export component RecoveryDialog inherits Window {
    title: "UlanziDock VibeWare - Dock disconnected";
    preferred-width: 480px;
    preferred-height: 250px;
    min-width: 420px;
    min-height: 230px;
    background: Palette.paper;
    default-font-family: "Consolas";
    default-font-size: 14px;
    icon: @image-url("../assets/brand/ulanzi-dock-icon.png");
    callback dismiss();
    VerticalLayout {
        padding: 22px;
        spacing: 16px;
        Text { text: "Dock disconnected"; color: Palette.blue; font-weight: 700; font-size: 20px; }
        Text {
            text: "Check the USB cable and power. UlanziDock is waiting for your dock and will resume automatically when it is ready.";
            color: Palette.ink;
            wrap: word-wrap;
        }
        Text { text: "You can close this message. Reconnection continues in the background."; color: Palette.muted; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            PixelButton { text: "Close"; clicked => { root.dismiss(); } }
        }
    }
}

export struct AppPage {
    name: string,
    enabled: bool,
}

export component MainWindow inherits Window {
    init => { WidgetPalette.color-scheme = ColorScheme.light; }
    title: "UlanziDock VibeWare — Configuration";
    preferred-width: 600px;
    preferred-height: 740px;
    min-width: 520px;
    min-height: 360px;
    background: Palette.paper;
    default-font-family: "Consolas";
    default-font-size: 14px;
    icon: @image-url("../assets/brand/ulanzi-dock-icon.png");
    in property <[string]> themes;
    in property <[AppPage]> app-pages;
    in-out property <int> theme-index;
    in-out property <bool> auto-switch;
    in-out property <bool> detect-applications;
    in-out property <int> poll-seconds: 1;
    in-out property <string> message;
    in-out property <bool> ready: false;
    in property <bool> resident;
    callback save(bool);
    callback page-toggled(int, bool);
    callback reload();
    callback open-file(bool);
    callback learn-vibeware();
    callback dismiss();
    VerticalLayout {
     spacing: 0px;
     ScrollView {
      horizontal-scrollbar-policy: always-off;
      viewport-width: self.visible-width;
      VerticalLayout {
        padding: 22px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            ProductWordmark { }
            VibeWareLink { clicked => { root.learn-vibeware(); } }
        }
        Text { text: "MAKE IT YOURS"; color: Palette.blue; font-size: 24px; font-weight: 700; }
        Text { text: "Dock theme"; color: Palette.ink; }
        ComboBox { enabled: root.ready; model: root.themes; current-index <=> root.theme-index; }
        CheckBox { enabled: root.ready; text: "Detect applications and page availability"; checked <=> root.detect-applications; }
        if root.detect-applications: CheckBox { enabled: root.ready; text: "Switch page automatically when the active app changes"; checked <=> root.auto-switch; }
        if !root.detect-applications: Text { text: "Enabled pages stay available. Automatic switching is off."; color: Palette.muted; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 12px;
            Text { text: "Check active application every (seconds)"; color: Palette.ink; vertical-alignment: center; }
            SpinBox { enabled: root.ready && root.detect-applications; minimum: 1; maximum: 60; value <=> root.poll-seconds; }
        }
        Rectangle { height: 2px; background: Palette.ink; }
        Text { text: "Application pages"; color: Palette.ink; font-weight: 700; }
        VerticalLayout {
            spacing: 10px;
            for row in Math.ceil(root.app-pages.length / 2): HorizontalLayout {
                spacing: 12px;
                CheckBox {
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    enabled: root.ready;
                    text: root.app-pages[row * 2].name;
                    checked: root.app-pages[row * 2].enabled;
                    toggled => { root.page-toggled(row * 2, self.checked); }
                }
                if row * 2 + 1 < root.app-pages.length: CheckBox {
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    enabled: root.ready;
                    text: root.app-pages[row * 2 + 1].name;
                    checked: root.app-pages[row * 2 + 1].enabled;
                    toggled => { root.page-toggled(row * 2 + 1, self.checked); }
                }
            }
        }
        Text { text: "Disabled pages are skipped. Your shortcuts stay saved."; color: Palette.muted; wrap: word-wrap; }
        Rectangle { height: 2px; background: Palette.ink; }
        Text { text: "Shortcuts and application mappings"; color: Palette.ink; }
        HorizontalLayout {
            spacing: 8px;
            PixelButton { text: "settings.json"; clicked => { root.open-file(false); } }
            PixelButton { text: "applications.yaml"; clicked => { root.open-file(true); } }
        }
        Text {
            text: "Saved changes apply when the controller restarts.\nExplicit command-line options still take precedence.";
            color: Palette.muted;
            wrap: word-wrap;
        }
        VibeWareFooter { learn => { root.learn-vibeware(); } }
      }
     }
     VerticalLayout {
        padding: 22px;
        spacing: 8px;
        Text { text: root.message; color: Palette.blue; wrap: word-wrap; min-height: 42px; }
        HorizontalLayout {
            spacing: 8px;
            PixelButton { text: "Reload"; clicked => { root.reload(); } }
            PixelButton { text: "Save"; enabled: root.ready; primary: true; clicked => { root.save(false); } }
            if root.resident: PixelButton { text: "Save + Restart"; enabled: root.ready; clicked => { root.save(true); } }
            PixelButton { text: "Close"; clicked => { root.dismiss(); } }
        }
     }
    }
}

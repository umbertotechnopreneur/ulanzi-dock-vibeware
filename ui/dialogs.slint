// Visual structure of About, Configuration and reconnect windows. Callbacks request
// Rust operations; this file does not access settings, HID or Store services itself.
// Scrollable bodies provide preferred sizes while footers remain reachable.
// Store properties are display-only snapshots for future premium functionality.

import { AboutSlint, CheckBox, ComboBox, ScrollView, SpinBox } from "std-widgets.slint";
import { Palette as WidgetPalette } from "std-widgets.slint";

global Palette {
    out property <color> paper: #fff4dc;
    out property <color> ink: #232a2f;
    out property <color> blue: #3a6a96;
    out property <color> muted: #526573;
}

// Text-sized, keyboard-accessible button shared by all dialogs. `enabled` gates
// pointer/focus input; `primary` only changes emphasis, never the callback behavior.
component PixelButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked();
    min-width: max(90px, caption.preferred-width + 24px);
    height: 36px;
    border-width: focus.has-focus ? 3px : 2px;
    border-color: Palette.ink;
    background: !root.enabled ? #dfddcf : touch.pressed ? Palette.ink : root.primary ? Palette.blue : Palette.paper;
    accessible-role: button;
    accessible-label: root.text;
    forward-focus: focus;
    caption := Text {
        text: root.text;
        font-weight: 600;
        color: !root.enabled ? Palette.muted : root.primary || touch.pressed ? Palette.paper : Palette.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        enabled: root.enabled;
        touch := TouchArea {
            enabled: root.enabled;
            clicked => { focus.focus(); root.clicked(); }
        }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// Fixed-size initiative badge. Its caller chooses the manifesto navigation action.
component VibeWareLink inherits Rectangle {
    callback clicked();
    width: 64px;
    height: 64px;
    clip: true;
    background: transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Palette.blue;
    accessible-role: button;
    accessible-label: "Participates in VibeWare. Read the manifesto";
    forward-focus: focus;
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/brand/vibeware-logo.png");
        image-fit: contain;
    }
    focus := FocusScope {
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { focus.focus(); root.clicked(); }
        }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// Bound the image to its allocated box instead of exposing its native pixel
// dimensions as layout constraints inside the scrollable dialogs.
component ProductWordmark inherits Rectangle {
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    min-height: 88px;
    max-height: 88px;
    clip: true;
    background: transparent;
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/brand/ulanzi-deck-logo.png");
        image-fit: contain;
    }
}

// Product/author links with a separate fixed footer for Configure and Close.
export component AboutDialog inherits Window {
    init => { WidgetPalette.color-scheme = ColorScheme.light; }
    title: "About UlanziDeck";
    preferred-width: 640px;
    preferred-height: body.preferred-height + footer.preferred-height;
    min-width: 420px;
    min-height: 360px;
    background: Palette.paper;
    default-font-family: "Consolas";
    default-font-size: 14px;
    in property <string> version;
    icon: @image-url("../assets/brand/ulanzi-dock-icon.png");
    in-out property <string> message;
    callback open-link(string);
    callback configure();
    callback dismiss();
    VerticalLayout {
     spacing: 0px;
     ScrollView {
      horizontal-scrollbar-policy: always-off;
      viewport-width: self.visible-width;
      body := VerticalLayout {
        padding: 22px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            ProductWordmark { }
            VibeWareLink { clicked => { root.open-link("manifesto"); } }
        }
        Text { text: "Open dock driver · v" + root.version; color: Palette.muted; horizontal-alignment: center; }
        Text { text: "Lightweight. Free. An alternative to the official Ulanzi app."; color: Palette.ink; horizontal-alignment: center; wrap: word-wrap; }
        Text {
            text: "I provide this software independently and as-is, without warranty. Use it at your own risk.";
            color: Palette.muted;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text { text: "I'm Umberto Giacobbi · MIT"; color: Palette.ink; horizontal-alignment: center; }
        HorizontalLayout {
            spacing: 8px;
            PixelButton { text: "UlanziDeck"; clicked => { root.open-link("project"); } }
            PixelButton { text: "VibeWare"; clicked => { root.open-link("vibeware"); } }
            PixelButton { text: "My website"; clicked => { root.open-link("website"); } }
        }
        Rectangle {
            min-height: 130px;
            max-height: 130px;
            background: Palette.paper;
            clip: true;
            AboutSlint { width: parent.width; height: parent.height; }
        }
        Text { text: root.message; color: Palette.muted; wrap: word-wrap; visible: root.message != ""; }
        HorizontalLayout {
            spacing: 8px;
            PixelButton { text: "Terms"; clicked => { root.open-link("terms"); } }
            PixelButton { text: "Privacy"; clicked => { root.open-link("privacy"); } }
        }
      }
     }
     footer := VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 12px;
        padding-bottom: 22px;
        HorizontalLayout {
            spacing: 8px;
            PixelButton { text: "Configure"; primary: true; clicked => { root.configure(); } }
            PixelButton { text: "Close"; clicked => { root.dismiss(); } }
        }
     }
    }
}

// One application-page checkbox. Names identify pages; enabled flags preserve keys.
export struct AppPage {
    name: string,
    enabled: bool,
}

// Installed choices and the saved selection for one existing Linux application page.
export struct LinuxAppPage {
    page: string,
    choices: [string],
    selected: int,
    available: bool,
    status: string,
}

// Slint 1.13 resets ComboBox selection when its model changes. Restore the saved
// index after those model notifications, without emitting a user-selection callback.
component SavedApplicationComboBox inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in property <int> saved-index: 0;
    callback selection-requested(int);
    min-width: combo.min-width;
    preferred-width: combo.preferred-width;
    min-height: combo.min-height;
    preferred-height: combo.preferred-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: combo;
    init => { selection-sync.start(); }
    changed model => { selection-sync.restart(); }
    changed saved-index => { selection-sync.restart(); }
    combo := ComboBox {
        width: parent.width;
        height: parent.height;
        model: root.model;
        enabled: root.enabled;
        selected => { root.selection-requested(self.current-index); }
    }
    selection-sync := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.stop();
            combo.current-index = root.saved-index;
        }
    }
}

// Editable preferences plus Store status. Rust owns stale-write checks, licensing,
// saving and restart requests; selecting a theme here does not activate it directly.
export component MainWindow inherits Window {
    init => { WidgetPalette.color-scheme = ColorScheme.light; }
    title: "UlanziDeck — Configuration";
    preferred-width: 820px;
    preferred-height: 900px;
    min-width: 720px;
    min-height: 360px;
    background: Palette.paper;
    default-font-family: "Consolas";
    default-font-size: 14px;
    icon: @image-url("../assets/brand/ulanzi-dock-icon.png");
    in property <[string]> themes;
    in property <[AppPage]> app-pages;
    in property <bool> linux-app-selection: false;
    in property <[LinuxAppPage]> linux-app-pages;
    in property <bool> foreground-supported: true;
    in property <string> save-hint: "Changes are saved automatically and applied while the controller is running.";
    in-out property <int> theme-index;
    in-out property <bool> auto-switch;
    in-out property <bool> detect-applications;
    in-out property <int> poll-seconds: 1;
    in-out property <string> message;
    in-out property <bool> ready: false;
    in property <bool> resident;
    in property <bool> store-edition;
    in property <bool> store-busy;
    in property <bool> store-owned;
    in property <bool> store-can-purchase;
    in property <string> store-price;
    in property <string> store-message;
    callback buy-themes();
    callback restore-purchases();
    callback preferences-changed();
    callback theme-changed();
    callback page-toggled(int, bool);
    callback linux-app-selected(int, int);
    callback linux-shortcuts-requested(int);
    callback refresh-linux-apps();
    callback open-file(bool);
    callback learn-vibeware();
    callback dismiss();
    VerticalLayout {
     spacing: 0px;
     ScrollView {
      horizontal-scrollbar-policy: always-off;
      viewport-width: self.visible-width;
      body := VerticalLayout {
        padding: 22px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            ProductWordmark { }
            VibeWareLink { clicked => { root.learn-vibeware(); } }
        }
        Text { text: "MAKE IT YOURS"; color: Palette.blue; font-size: 24px; font-weight: 700; }
        Text { text: "Dock theme"; color: Palette.ink; }
        ComboBox { enabled: root.ready; model: root.themes; current-index <=> root.theme-index; selected => { root.theme-changed(); } }
        if root.foreground-supported: VerticalLayout {
            spacing: 14px;
            CheckBox { enabled: root.ready; text: "Detect applications and page availability"; checked <=> root.detect-applications; toggled => { root.preferences-changed(); } }
            if root.detect-applications: CheckBox { enabled: root.ready; text: "Switch page automatically when the active app changes"; checked <=> root.auto-switch; toggled => { root.preferences-changed(); } }
            if !root.detect-applications: Text { text: "Enabled pages stay available. Automatic switching is off."; color: Palette.muted; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 12px;
                Text { text: "Check active application every (seconds)"; color: Palette.ink; vertical-alignment: center; wrap: word-wrap; }
                SpinBox { enabled: root.ready && root.detect-applications; minimum: 1; maximum: 60; value <=> root.poll-seconds; edited => { root.preferences-changed(); } }
            }
        }
        if !root.foreground-supported: Text {
            text: "Choose pages manually. Active application detection is unavailable on this system.";
            color: Palette.muted;
            wrap: word-wrap;
        }
        Rectangle { height: 2px; background: Palette.ink; }
        Text { text: "Application pages"; color: Palette.ink; font-weight: 700; }
        VerticalLayout {
            spacing: 10px;
            for row in Math.ceil(root.app-pages.length / 2): HorizontalLayout {
                spacing: 12px;
                CheckBox {
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    enabled: root.ready;
                    text: root.app-pages[row * 2].name;
                    checked: root.app-pages[row * 2].enabled;
                    toggled => { root.page-toggled(row * 2, self.checked); }
                }
                if row * 2 + 1 < root.app-pages.length: CheckBox {
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    enabled: root.ready;
                    text: root.app-pages[row * 2 + 1].name;
                    checked: root.app-pages[row * 2 + 1].enabled;
                    toggled => { root.page-toggled(row * 2 + 1, self.checked); }
                }
            }
        }
        Text { text: "Disabled pages are skipped. Your shortcuts stay saved."; color: Palette.muted; wrap: word-wrap; }
        if root.linux-app-selection: VerticalLayout {
            spacing: 14px;
            Rectangle { height: 2px; background: Palette.ink; }
            HorizontalLayout {
                spacing: 12px;
                Text { text: "Installed Linux applications"; color: Palette.ink; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                PixelButton { text: "Refresh"; enabled: root.ready; clicked => { root.refresh-linux-apps(); } }
            }
            Text {
                text: "Choosing an installed app keeps your shortcuts. Use suggested shortcuts to replace this page’s action keys. Return to applications.yaml mapping to use the shared shortcuts again.";
                color: Palette.muted;
                wrap: word-wrap;
            }
            for row in root.linux-app-pages.length: VerticalLayout {
                spacing: 6px;
                Text { text: root.linux-app-pages[row].page; color: Palette.ink; font-weight: 600; }
                HorizontalLayout {
                    spacing: 12px;
                    SavedApplicationComboBox {
                        min-width: 0px;
                        horizontal-stretch: 1;
                        enabled: root.ready;
                        model: root.linux-app-pages[row].choices;
                        saved-index: root.linux-app-pages[row].selected;
                        selection-requested(index) => { root.linux-app-selected(row, index); }
                    }
                    PixelButton {
                        text: "Use suggested shortcuts";
                        enabled: root.ready && root.linux-app-pages[row].available;
                        clicked => { root.linux-shortcuts-requested(row); }
                    }
                }
                Text { text: root.linux-app-pages[row].status; color: Palette.muted; wrap: word-wrap; }
            }
        }
        Rectangle { height: 2px; background: Palette.ink; }
        Text { text: "Shortcuts and application mappings"; color: Palette.ink; }
        HorizontalLayout {
            spacing: 8px;
            PixelButton { text: "settings.json"; clicked => { root.open-file(false); } }
            PixelButton { text: "applications.yaml"; clicked => { root.open-file(true); } }
        }
        Text {
            text: root.save-hint;
            color: Palette.muted;
            wrap: word-wrap;
        }
      }
     }
     footer := VerticalLayout {
        padding: 22px;
        spacing: 8px;
        Text { text: root.message; color: Palette.blue; wrap: word-wrap; min-height: 42px; }
        HorizontalLayout {
            spacing: 8px;
            PixelButton { text: "Close"; clicked => { root.dismiss(); } }
        }
     }
    }
}
